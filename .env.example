# Скопируйте в .env и заполните; Makefile файл автоматически не читает.
# Секреты не коммитить.

# Чтение ClickHouse (тот же DSN, что в ~/.config/rosstat/env).
CLICKHOUSE_URL=clickhouse://user:password@localhost:9000/default

# Запись live-прогноза в forecast_log — только через ingest-контур.
INGEST_URL=http://127.0.0.1:8081
INGEST_TOKEN=

# MLflow: канонические прогоны — staging через SSH-туннель.
MLFLOW_TRACKING_URI=http://127.0.0.1:15001
